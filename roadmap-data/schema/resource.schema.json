{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bettyguo/ai-engineer-roadmap/roadmap-data/schema/resource.schema.json",
  "title": "Resource",
  "description": "A curated learning resource attached to a node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "url",
    "type",
    "annotation",
    "difficulty",
    "free",
    "addedAt",
    "verifiedAt"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 2 },
    "author": { "type": "string" },
    "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
    "type": {
      "enum": [
        "paper",
        "course",
        "repo",
        "book",
        "video",
        "blog",
        "tool",
        "official",
        "interactive"
      ]
    },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "annotation": { "type": "string", "minLength": 4, "maxLength": 240 },
    "difficulty": { "enum": ["intro", "intermediate", "advanced"] },
    "free": { "type": "boolean" },
    "addedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verifiedBy": { "type": "string" }
  }
}
